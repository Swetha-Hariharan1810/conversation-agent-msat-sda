# Generated by running the project, never by editing it.

# Bytecode and test caches
__pycache__/
*.py[cod]
.pytest_cache/

# Editable install metadata, written by `uv sync` because the package must be
# installable for `langgraph dev` to import the graph by module path.
*.egg-info/
build/
dist/

# Environments and local secrets. The provider settings in llm/client.py are
# read from the environment; a .env holding real keys must not be committed.
.venv/
.env
.env.*
!.env.example

# Live-run transcripts. Generated on every `pytest tests/live` run and written
# per-timestamp, so they would bury a diff. results/README.md says how to keep
# one deliberately (git add -f).
results/*
!results/README.md
